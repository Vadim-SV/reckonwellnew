# Copy to .env.local for local development. Never commit real values.
# All of these are read on the server only — none are prefixed NEXT_PUBLIC_.

# Public site URL (used for canonical URLs, sitemap and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional email (enquiry + partner forms) ---
# Set ONE provider. Resend is used if both are set. With neither, emails are
# logged in development and form submissions fail in production (so no lead is lost silently).
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=vadim.s@reckonwell.com
EMAIL_FROM_NAME=Reckonwell
EMAIL_INTERNAL_TO=vadim.s@reckonwell.com

# --- Stage 7: booking storage (to prevent double bookings) ---
# e.g. a Neon / Vercel Postgres connection string
DATABASE_URL=

# --- Spam protection for public forms (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
