# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# Public site URL (canonical URLs, sitemap, links in emails and PDFs)
NEXT_PUBLIC_SITE_URL=https://www.reckonwell.com

# ── Transactional email ──────────────────────────────────────────────────────
# Brevo is used if set (preferred, as on the current site); otherwise Resend.
# Use a NEWLY generated key: the old Brevo key was included in a source archive.
BREVO_API_KEY=
RESEND_API_KEY=
# Sender must be on a domain verified with the provider (SPF + DKIM at IONOS).
EMAIL_FROM_ADDRESS=vadim.s@reckonwell.com
EMAIL_FROM_NAME=Reckonwell
EMAIL_INTERNAL_TO=vadim.s@reckonwell.com

# ── Storage (enquiries and bookings; prevents double bookings) ───────────────
# Postgres connection string, e.g. Neon or Vercel Postgres. Tables are created automatically.
DATABASE_URL=

# ── Live discovery-call booking (Google Calendar) ────────────────────────────
# Without all four, /book runs in "request a call" mode (no invented slots).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Create a Google Meet link for each call (default true). Set to "false" to disable.
BOOKING_CREATE_GOOGLE_MEET=true
# Optional fixed location/link shown when no Meet link is created, e.g. a Teams link or "Phone call".
BOOKING_LOCATION=

# ── Analytics (not wired yet) ────────────────────────────────────────────────
# Conversion events are prepared in src/lib/analytics.ts but send nothing until an
# analytics tag is loaded with visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
